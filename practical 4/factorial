def factorial_iterative(n):
    result = 1
    for i in range(2, n + 1):
        result *= i
    return result

def factorial_recursive(n):
    if n <= 1:
        return 1
    return n * factorial_recursive(n - 1)

# Helper function to approximate execution ticks without external libraries
def measure_ticks(func, n, iterations=10000):
    # Benchmark function execution time relative to simple loop overhead
    for _ in range(iterations):
        func(n)

